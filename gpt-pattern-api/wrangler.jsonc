{
  "name": "dvp-gpt-pattern-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-06",
  "vars": {
    "ALLOWED_ORIGIN": "https://trongdatfx-hash.github.io",
    "OPENAI_MODEL": "gpt-5.6-terra"
